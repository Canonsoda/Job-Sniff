# Copy to .env and fill in. Never commit the filled-in file.
#   cp backend/.env.example backend/.env

# ── Required ──────────────────────────────────────────────────────────────────

# The process exits if this connection fails.
MONGO_URI=mongodb://127.0.0.1:27017/jobsniff

# Signing key for every JWT. Use a long random string, and a different one per
# environment - rotating it invalidates all existing tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Allowed CORS origin, and where the Google OAuth callback redirects back to.
CLIENT_URL=http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────

PORT=5000

# 'production' hides stack traces from error responses.
NODE_ENV=development

# ── AI parsing service ────────────────────────────────────────────────────────

CV_LLM_URL=http://127.0.0.1:5001

# A parse takes 40-60s and the AI service retries up to 3 times on rate limits,
# so anything much below this cuts off legitimate uploads.
CV_LLM_TIMEOUT_MS=180000

# How often to ping the AI service's /health to keep it warm. Set to 0 to
# disable (sensible for local development).
KEEPALIVE_INTERVAL_MS=600000

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# Optional. Without these, search returns an empty result set instead of erroring.

ELASTICSEARCH_URL=https://your-deployment.es.region.cloud.es.io
ELASTICSEARCH_API=your-base64-api-key
ELASTICSEARCH_INDEX=resumes

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Optional. Email/password login works without these; the Google buttons will not.
# Console: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Welcome email ─────────────────────────────────────────────────────────────
# Optional. Requires a Gmail *app password*, not the account password.
# https://myaccount.google.com/apppasswords

EMAIL_USER=
EMAIL_PASS=

# ── File storage ──────────────────────────────────────────────────────────────
# 'local' keeps PDFs on disk and is fine for development. Use 's3' in
# production: hosts like Render give each deploy a fresh container, so local
# files disappear on the next deploy while the database still lists them.
#
# Leaving STORAGE_DRIVER unset selects 's3' automatically when S3_BUCKET is set.

STORAGE_DRIVER=local

S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=resumes

# Set for S3-compatible providers (Cloudflare R2, Backblaze B2, MinIO).
# Leave empty for AWS S3.
S3_ENDPOINT=
