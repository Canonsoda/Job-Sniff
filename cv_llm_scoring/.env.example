# Copy to .env and fill in. Never commit the filled-in file.
#   cp cv_llm_scoring/.env.example cv_llm_scoring/.env

# ── Required ──────────────────────────────────────────────────────────────────

# https://openrouter.ai/keys - free-tier models work for development.
OPENROUTER_API_KEY=sk-or-v1-...

# ── Optional ──────────────────────────────────────────────────────────────────

# Any model id OpenRouter routes to. ':free' variants are rate limited, which is
# why process_resume.py retries with backoff; a paid model removes most upload
# failures. https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

HOST=0.0.0.0
PORT=5001

# Set to 1 to log each parsed payload. Off by default: this used to be an
# unconditional write to a fixed parsed_resume.json, which two concurrent
# requests would overwrite and which fails outright on a read-only filesystem.
DEBUG_DUMP_PARSED=0
