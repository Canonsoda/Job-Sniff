# Copy to .env and fill in.
#   cp frontend/.env.example frontend/.env
#
# WARNING: every VITE_-prefixed variable is inlined into the client bundle at
# build time and is readable by anyone in DevTools. Only public values belong
# here - never an API key or a secret. The prefix is the safety gate: variables
# without it are not exposed to client code at all.

# Base URL of the backend API, including the /api path.
#   local        http://localhost:5000/api
#   production   https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Only used by server.js, the Express process that serves the built SPA in
# production. Not needed for `npm run dev`.
PORT=5173
